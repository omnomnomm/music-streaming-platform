# Copy this file to .env and fill in real values — .env is gitignored, never commit it.

# Frontend (Vite exposes anything prefixed VITE_ to client code) — from
# Supabase Dashboard -> Project Settings -> Data API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Only needed by Claude / scripts to apply the SQL migrations in sql/ directly
# (psql, not the browser) — from Supabase Dashboard -> Project Settings ->
# Database -> Connection string -> URI. Fill in the real password in place of
# [YOUR-PASSWORD]. Never used by the React app itself.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
